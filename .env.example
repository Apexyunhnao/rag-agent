# 环境变量样例 —— 复制成 .env 再填真实值
# .env 已在 .gitignore 里，不会入库。
#
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"

# ── 认证（必填）────────────────────────────────────────────
# 必须与 orchestrator-agent / customer-service-agent 的 AUTH_SECRET **完全相同**（共享验签）。
# ⚠️ 未配置时服务会拒绝启动（fail-closed）。
AUTH_SECRET=

# ── 模型服务 ───────────────────────────────────────────────
DEEPSEEK_API_KEY=
# 走 OpenAI 兼容接口，默认官方地址；如需网关可覆盖
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── 本地嵌入模型 ───────────────────────────────────────────
# 模型名（本地 CPU 推理，首次运行会下载约 400MB）
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 国内下载 HuggingFace 模型走镜像站；海外环境可留空
HF_ENDPOINT=https://hf-mirror.com
